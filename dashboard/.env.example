# Dashboard settings. Copy to .env.local for `npm run dev`.
# Public values only: the anon key is safe in the browser because row level
# security limits every query to signed-in team members. Never put the
# service-role key here or in any NEXT_PUBLIC_* variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
