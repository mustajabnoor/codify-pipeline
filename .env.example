# Codify Pipeline — every variable the project reads. Copy to .env for local use.
# Never commit real values. In GitHub Actions these are repository secrets.
# A missing key only fails the source that needs it; other sources still run.

# --- Supabase -------------------------------------------------------------
# Agent only (server side). Bypasses RLS — never expose to the browser/dashboard.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Dashboard (safe for the browser; RLS protects the data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- AI (extract, score, draft) -------------------------------------------
ANTHROPIC_API_KEY=

# --- Collectors -----------------------------------------------------------
# Job postings (LinkedIn Jobs / Indeed actors), Google Maps scraper
APIFY_TOKEN=
# Tech-stack detection (PageSpeed scores)
GOOGLE_PAGESPEED_API_KEY=
# Google Maps / agency partners
GOOGLE_PLACES_API_KEY=
# Social listening
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
# Product launches
PRODUCTHUNT_TOKEN=

# --- Enrichment + verification --------------------------------------------
HUNTER_API_KEY=
APOLLO_API_KEY=
MILLIONVERIFIER_API_KEY=

# --- Alerts (phase 2) -----------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
