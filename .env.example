# Codify Pipeline — every variable the project reads. Copy to .env for local use.
# Never commit real values. In GitHub Actions these are repository secrets.
# A missing key only fails the source that needs it; other sources still run.

# --- Supabase -------------------------------------------------------------
# Agent only (server side). Bypasses RLS — never expose to the browser/dashboard.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Dashboard (safe for the browser; RLS protects the data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- AI (extract, score, draft) -------------------------------------------
# In Claude Code cloud sessions store it as CODIFY_ANTHROPIC_API_KEY instead,
# so Claude Code itself does not pick it up. The agent reads either name.
ANTHROPIC_API_KEY=

# --- Collectors -----------------------------------------------------------
# Job postings (LinkedIn Jobs / Indeed actors), Google Maps scraper
APIFY_TOKEN=
# Tech-stack detection (PageSpeed scores)
GOOGLE_PAGESPEED_API_KEY=
# Google Maps / agency partners
GOOGLE_PLACES_API_KEY=
# Social listening
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
# Product launches
PRODUCTHUNT_TOKEN=

# --- Enrichment + verification --------------------------------------------
# Optional. Without HUNTER_API_KEY leads are saved with no contact; without
# MILLIONVERIFIER_API_KEY found emails stay "unverified". Dry runs only use
# them with --enrich.
HUNTER_API_KEY=
APOLLO_API_KEY=
MILLIONVERIFIER_API_KEY=

# --- Alerts (phase 2) -----------------------------------------------------
# Slack Incoming Webhook URL for the alerts channel (daily summary, run failures).
SLACK_WEBHOOK_URL=
